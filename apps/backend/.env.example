APP_NAME=PipelineMedic

APP_ENV=production

DEBUG=false

API_PREFIX=/api

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/pipelinemedic

FRONTEND_URL=http://localhost,http://localhost:5173

GITHUB_WEBHOOK_SECRET=

GITHUB_TOKEN=

GITHUB_OAUTH_CLIENT_ID=

GITHUB_OAUTH_CLIENT_SECRET=

GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

GITHUB_OAUTH_STATE_TTL_SECONDS=600

GITHUB_APP_ID=

GITHUB_APP_PRIVATE_KEY=

GITHUB_APP_SLUG=

GITHUB_APP_INSTALL_URL=

GITHUB_APP_WEBHOOK_SECRET=

GITHUB_APP_STATE_TTL_SECONDS=600

GROQ_API_KEY=replace-with-your-groq-api-key

GROQ_MODEL=openai/gpt-oss-120b

AI_ENABLED=false

AI_TIMEOUT_SECONDS=15

AI_MAX_LOG_CHARS=30000

MAX_LOG_SIZE_BYTES=5000000

MAX_AI_LOG_CHARACTERS=30000

GITHUB_LOG_MAX_BYTES=10000000

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

ACCESS_TOKEN_MINUTES=15

REFRESH_TOKEN_DAYS=30

AUTH_ENABLED=true

EXPOSE_INVITATION_URLS=false

API_KEY_RATE_LIMIT_PER_MINUTE=60

API_KEY_RATE_LIMIT_WINDOW_SECONDS=60

API_KEY_DEFAULT_EXPIRY_DAYS=30

REDIS_URL=redis://redis:6379/0

REDIS_QUEUE_NAME=pipelinemedic:jobs

WORKER_MAX_ATTEMPTS=3

WORKER_BACKOFF_SECONDS=1

PATCH_GENERATION_ENABLED=false

PATCH_MAX_FILES=10

PATCH_MAX_CHANGED_LINES=200

PATCH_MAX_BYTES=100000

PATCH_ALLOWED_EXTENSIONS=.py,.ts,.tsx,.js,.jsx,.java,.go,.cs,.md

PATCH_CONTEXT_MAX_BYTES=200000

